{"id": "dev021", "question": "Workflow受理信号是哪帧？", "split": "dev", "type": "fact_single", "unanswerable_category": null, "edition": null, "expected_route": "SINGLE", "gold_docs": ["api-reference/guides/streaming"], "nuggets": [{"text": "首个data事件workflow_started表示Workflow运行已受理。", "importance": "vital"}, {"text": "第一帧ping只表示连接保活。", "importance": "okay"}], "persona": "novice", "phrasing": "natural_short", "premise": "indirect", "lexical": "similar", "behavior_group": "single", "behavior_subtype": "short", "guessable_without_docs": null, "gold_doc_groups": [["api-reference/guides/streaming"]], "reference_answer": "应等到首个data事件workflow_started。第一帧ping只用于保活，不能当作业务受理信号。", "most_likely_failure": "把HTTP连接或ping当成运行已受理。"}
