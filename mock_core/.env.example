# Compose 网络内的 MySQL。宿主机启动时使用 127.0.0.1 和 MySQL 发布端口。
MOCK_MYSQL_HOST=mysql
MOCK_MYSQL_PORT=3306
MOCK_MYSQL_DATABASE=grounded_mock
MOCK_MYSQL_USER=grounded
MOCK_MYSQL_PASSWORD=grounded

# 全局故障参数，概率范围是 0 到 1。以接口名为前缀的变量可覆盖这里的默认值。
MOCK_FAULT_DELAY_MS=0
MOCK_FAULT_TIMEOUT_RATE=0
MOCK_FAULT_5XX_RATE=0
MOCK_FAULT_SEED=331107
MOCK_ALLOW_FAULT_HEADERS=false
