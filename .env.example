# 复制为 .env 再修改；.env 不提交。字段与 backend/app/core/config.py 的 Settings 一一对应。

# 数据库：默认值对应 docker-compose.yml 里的 db 服务
DATABASE_URL=postgresql+asyncpg://grounded:grounded@localhost:5432/grounded_rag
ELASTICSEARCH_URL=http://127.0.0.1:9200
REDIS_URL=redis://127.0.0.1:6379/0
MYSQL_URL=mysql://grounded:grounded@127.0.0.1:3306/grounded_mock
# 数据库操作超时（秒）
DB_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO

# 嵌入模型：qwen3（默认）、bge-m3、fake（离线假实现，测试用）
EMBEDDING_MODEL=qwen3
EMBED_DEVICE=mps
EMBED_BATCH_SIZE=32

# 精排模型：qwen3（默认）、bge、fake（测试用）、none（不精排）
RERANKER_MODEL=qwen3

# 对话模型：gateway（第二版）、deepseek（原直接接入）、fake（测试用）
CHAT_MODEL=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 本机网关业务端点及模型别名；填入自行生成的 sk- 开头随机密钥
GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
GATEWAY_API_KEY=
GATEWAY_SMALL_MODEL=small
GATEWAY_LARGE_MODEL=deepseek-v4-pro
# agent 每天的预算（元），超了就拒绝调用；0 表示不限制
DAILY_BUDGET_CNY=10

# 每个客户端 IP 每分钟最多请求次数；0 表示不限制
RATE_LIMIT_PER_MINUTE=30
# 启动时预热（建检索器、加载模型）；poe serve 默认打开
PREWARM=false

# 可选云端过程记录；两项密钥都填才启用，项目区域须与 BASE_URL 一致
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 以下只给 docker compose 用，不是 Settings 字段：
# 本机 5432 被占用时取消注释并改成别的空闲端口（如 15432），同时把上面 DATABASE_URL 的端口也改成同一个
# DB_PORT=5432
# ES_PORT=9200
# REDIS_PORT=6379
# MYSQL_PORT=3306
# MYSQL_PASSWORD=grounded
# GATEWAY_PORT=4000
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=ollama_chat/qwen3:4b-instruct
